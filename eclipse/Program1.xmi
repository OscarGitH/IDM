<?xml version="1.0" encoding="UTF-8"?>
<robot:Program
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:robot="http://www.example.org/robot">
  <fonctions
      nom="entry">
    <bloc>
      <instrs
          xsi:type="robot:SetSpeed"
          unit="MM">
        <vitesse
            xsi:type="robot:IntLiteral"
            valeur="150"/>
      </instrs>
      <instrs
          xsi:type="robot:VarDecl"
          nom="number"
          type="INT">
        <init
            xsi:type="robot:IntLiteral"/>
      </instrs>
      <instrs
          xsi:type="robot:Loop">
        <cond
            xsi:type="robot:CompareExpr"
            op="LT">
          <left
              xsi:type="robot:VarRef"
              variable="//@fonctions.0/@bloc/@instrs.1"/>
          <right
              xsi:type="robot:IntLiteral"
              valeur="5"/>
        </cond>
        <bloc>
          <instrs
              xsi:type="robot:Affectation"
              variable="//@fonctions.0/@bloc/@instrs.1">
            <valeur
                xsi:type="robot:ArithBinaryExpr">
              <left
                  xsi:type="robot:VarRef"
                  variable="//@fonctions.0/@bloc/@instrs.1"/>
              <right
                  xsi:type="robot:IntLiteral"
                  valeur="1"/>
            </valeur>
          </instrs>
        </bloc>
      </instrs>
    </bloc>
  </fonctions>
</robot:Program>
